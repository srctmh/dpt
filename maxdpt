                      box_top; box_line "${GREEN}CODE ACCEPTED${RESET}"; box_mid
                      box_line "+${result} credits"; box_line "Total: ${CREDITS}"; box_bot
                      sleep 1; load_credits
                      [ "$CREDITS" -ge 2 ] && break
                    fi
                    ;;
                esac
              fi
              ;;
          esac
        done
      fi
      ;;
    0) mode="skip"; cost=1; ptype_label="Skip" ;;
    *) mode="normal"; cost=1; ptype_label="Normal" ;;
  esac

  if [ "$CREDITS" -lt "$cost" ]; then
    clear_screen
    box_top; box_line "${YELLOW}Not enough credits${RESET}"; box_mid
    box_line "Need ${cost}, have ${CREDITS}"; box_bot
    open_credits_url; pause; return
  fi

  local out_root="${STORAGE_ROOT:-/storage/emulated/0}/${OUTPUT_FOLDER}"
  mkdir -p "$out_root" 2>/dev/null || true
  local apk_name apk_base apk_ext work_dir
  apk_name=$(basename "$apk_path")
  apk_ext="${apk_name##*.}"
  apk_base="${apk_name%.*}"
  work_dir="${TMP_BASE}/p_$$"
  rm -rf "$work_dir"; mkdir -p "$work_dir" "$TMP_BASE"

  local sz
  sz=$(du -h "$apk_path" 2>/dev/null | awk '{print $1}')
  show_progress 0 "$apk_name" "$sz"; sleep 0.25

  CURRENT="$apk_path"
  LIB_TMP=""; RES_TMP=""

  # Library
  show_progress 1 "$apk_name" "$sz"
  if [ "$lib_c" != "0" ]; then
    if apply_library "$CURRENT" "$lib_c"; then
      CURRENT="$LIB_RESULT"; LIB_TMP="$LIB_RESULT"
    else
      clear_screen; box_top; box_line "${RED}Library Protect failed${RESET}"; box_bot
      rm -rf "$work_dir" "$TMP_BASE/lib_$$" 2>/dev/null; pause; return
    fi
  fi
  sleep 0.2

  # Resource
  show_progress 2 "$apk_name" "$sz"
  if [ "$res_c" = "1" ]; then
    local shield_out="${work_dir}/res.apk"
    if [ -f "$APKSHIELD" ]; then
      if python3 "$APKSHIELD" "$CURRENT" "$shield_out" --no-sign 2>"${work_dir}/res.log"; then
        if [ -f "$shield_out" ]; then CURRENT="$shield_out"; RES_TMP="$shield_out"; fi
      else
        clear_screen; box_top; box_line "${RED}Resource Protect failed${RESET}"; box_bot
        rm -rf "$work_dir" "$TMP_BASE/lib_$$" 2>/dev/null; pause; return
      fi
    fi
  fi
  sleep 0.2

  # MAX engine
  show_progress 3 "$apk_name" "$sz"
  local produced=""
  if [ "$mode" != "skip" ]; then
    local log_out="${work_dir}/run.log"
    (
      cd "$CORE_DIR" || exit 90
      if [ "${#extra_flags[@]}" -gt 0 ]; then
        java -jar "$CORE_JAR" -f "$CURRENT" -o "$work_dir" "${extra_flags[@]}"
      else
        java -jar "$CORE_JAR" -f "$CURRENT" -o "$work_dir"
      fi
    ) >"$log_out" 2>&1
    local st=$?
    if [ "$st" -ne 0 ]; then
      local reason
      reason=$(tail -n 3 "$log_out" 2>/dev/null | tr '\n' ' ' | cut -c1-40)
      clear_screen
      box_top; box_line "${RED}${BOLD}PROTECTION FAILED${RESET}"; box_mid
      box_line "Reason: ${reason:-Unknown}"; box_bot
      log_history "$apk_name" "$ptype_label" "Failed"
      rm -rf "$work_dir" "$TMP_BASE/lib_$$" 2>/dev/null; pause; return
    fi
    produced=$(find "$work_dir" -type f \( -name "*_signed.apk" -o -name "*.apk" -o -name "*.aab" \) ! -name "res.apk" ! -name "*_unsign*" -print 2>/dev/null | head -n1)
  else
    # Skip MAX — deliver current (lib/resource only)
    produced="${work_dir}/final.${apk_ext}"
    cp "$CURRENT" "$produced"
  fi

  show_progress 4 "$apk_name" "$sz"; sleep 0.2
  show_progress 5 "$apk_name" "$sz"; sleep 0.2

  if [ -z "$produced" ] || [ ! -f "$produced" ]; then
    clear_screen; box_top; box_line "${RED}No output file${RESET}"; box_bot
    log_history "$apk_name" "$ptype_label" "Failed"
    rm -rf "$work_dir" "$TMP_BASE/lib_$$" 2>/dev/null; pause; return
  fi

  local final_path
  final_path=$(unique_output_name "$out_root" "$apk_base" "$apk_ext")
  mv "$produced" "$final_path" || {
    clear_screen; box_top; box_line "${RED}Could not save${RESET}"; box_bot
    rm -rf "$work_dir" "$TMP_BASE/lib_$$" 2>/dev/null; pause; return
  }

  # Full cleanup
  rm -rf "$work_dir" "$TMP_BASE/lib_$$" 2>/dev/null || true
  find "$HOME" -maxdepth 1 -type d -name "apkshield_*" -exec rm -rf {} + 2>/dev/null || true

  deduct "$cost"
  log_history "$apk_name" "$ptype_label" "Success"
  load_credits

  clear_screen
  box_top
  box_line "${GREEN}${BOLD}SUCCESS${RESET}"
  box_mid
  box_line "Protection applied successfully"
  box_line ""
  box_line "File     :  ${apk_name}"
  box_line "Output   :  $(basename "$final_path")"
  box_line "Location :  /storage/emulated/0/@SRCTMH/"
  box_line "Credits  :  ${CREDITS} left"
  box_bot
  pause
}

# ── Entry ─────────────────────────────────────────────────
require_config
load_credits
main_menu
