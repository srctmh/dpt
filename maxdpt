# ── Device ID & Credits (NEW system) ──────────────────────
get_device_id(){
  local android_id termux_hash raw hex
  android_id=$(getprop ro.serialno 2>/dev/null || true)
  [ -z "$android_id" ] || [ "$android_id" = "unknown" ] && android_id=$(getprop ro.boot.serialno 2>/dev/null || true)
  [ -z "$android_id" ] && android_id=$(cat /data/data/com.termux/files/usr/etc/uuid 2>/dev/null || true)
  [ -z "$android_id" ] && android_id="UNKNOWN"
  termux_hash=$(printf '%s' "${PREFIX:-$HOME}" | cksum 2>/dev/null | awk '{print $1}')
  raw="${android_id}-${termux_hash}-MAX2026"
  hex=$(printf '%s' "$raw" | md5sum 2>/dev/null | awk '{print $1}' | head -c 12 | tr 'a-f' 'A-F')
  [ -z "$hex" ] && hex=$(printf '%s' "$raw" | cksum | awk '{print $1}' | head -c 12)
  printf 'MAX-%s\n' "$hex"
}

init_credits(){
  mkdir -p "$BASE"
  if [ ! -f "$CREDITS_FILE" ]; then
    cat > "$CREDITS_FILE" <<EOF
device_id=$(get_device_id)
credits=0
EOF
  fi
}
save_credits(){
  cat > "$CREDITS_FILE" <<EOF
device_id=${DEVICE_ID}
credits=${CREDITS}
EOF
}
load_credits(){
  init_credits
  # shellcheck disable=SC1090
  . "$CREDITS_FILE"
  DEVICE_ID="${device_id:-$(get_device_id)}"
  CREDITS="${credits:-0}"
  case "$CREDITS" in (*[!0-9]*|"") CREDITS=0 ;; esac
}
deduct(){
  local n="$1"
  [ "$CREDITS" -ge "$n" ] || return 1
  CREDITS=$((CREDITS - n))
  save_credits
  return 0
}
add_credits(){
  local n="$1"
  CREDITS=$((CREDITS + n))
  save_credits
}

hex_to_charset(){
  local hex="$1" len="$2" out="" i=0 byte
  while [ ${#out} -lt "$len" ] && [ "$i" -lt ${#hex} ]; do
    byte=$((16#${hex:$i:2}))
    out="${out}${KEY_CHARS:$((byte % 32)):1}"
    i=$((i+2))
  done
  printf '%s\n' "$out"
}
generate_key_for(){
  local did="$1" amount="$2" payload hash body checksum
  payload="${did}|${amount}|max_v1|${SECRET_SALT}"
  hash=$(printf '%s' "$payload" | sha256sum 2>/dev/null | awk '{print $1}')
  if [ -z "$hash" ]; then
    hash=$(printf '%s' "$payload" | md5sum 2>/dev/null | awk '{print $1}')
    hash="${hash}${hash}"
  fi
  body=$(hex_to_charset "$hash" 16)
  checksum=$(hex_to_charset "${hash: -16}" 4)
  printf 'MAX-%s-%s-%s-%s-%s\n' "${body:0:4}" "${body:4:4}" "${body:8:4}" "${body:12:4}" "$checksum"
}
decode_credits_from_key(){
  local key="$1" did="$DEVICE_ID" c gen
  for c in 1 2 3 5 10 15 20 25 30 40 50 75 100 150 200 250 300 500 750 1000 1500 2000 5000; do
    gen=$(generate_key_for "$did" "$c")
    [ "$gen" = "$key" ] && { printf '%s\n' "$c"; return 0; }
  done
  c=1
  while [ "$c" -le 500 ]; do
    gen=$(generate_key_for "$did" "$c")
    [ "$gen" = "$key" ] && { printf '%s\n' "$c"; return 0; }
    c=$((c+1))
  done
  printf '\n'; return 1
}
verify_code(){
  local key="$1" amount
  key=$(printf '%s' "$key" | tr -d '[:space:]' | tr 'a-z' 'A-Z')
  if ! printf '%s' "$key" | grep -qE '^MAX-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}$'; then
    echo "INVALID_FORMAT"; return 1
  fi
  mkdir -p "$BASE"
  if [ -f "$ACTIVATED_FILE" ] && grep -qxF "$key" "$ACTIVATED_FILE" 2>/dev/null; then
    echo "ALREADY_USED"; return 1
  fi
  amount=$(decode_credits_from_key "$key")
  [ -z "$amount" ] && { echo "INVALID_KEY"; return 1; }
  case "$amount" in (*[!0-9]*) echo "INVALID_KEY"; return 1 ;; esac
  [ "$amount" -lt 1 ] && { echo "INVALID_KEY"; return 1; }
  add_credits "$amount"
  echo "$key" >> "$ACTIVATED_FILE"
  echo "$amount"
  return 0
}

