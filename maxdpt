unique_output_name(){
  local dir="$1" base="$2" ext="$3" candidate n=1
  candidate="${dir}/${base}.${ext}"
  [ ! -e "$candidate" ] && { printf '%s\n' "$candidate"; return; }
  while [ -e "${dir}/${base}(${n}).${ext}" ]; do n=$((n+1)); done
  printf '%s\n' "${dir}/${base}(${n}).${ext}"
}

# ── Library Protect (ZIP) ─────────────────────────────────
apply_library(){
  local apk_path="$1" choice="$2"
  local work="$TMP_BASE/lib_$$"
  local extracted="$work/ex"
  local out_apk="$work/out.apk"
  rm -rf "$work"; mkdir -p "$extracted"
  unzip -q -o "$apk_path" -d "$extracted" 2>/dev/null || return 1
  [ -f "$extracted/AndroidManifest.xml" ] || return 1
  case "$choice" in
    1) mkdir -p "$extracted/lib/armeabi-v7a"
       cp "${LIBS_DIR}/jiagu/libjiagu.so" "$extracted/lib/armeabi-v7a/" || return 1 ;;
    2) mkdir -p "$extracted/lib/arm64-v8a"
       cp "${LIBS_DIR}/tencent/libshell-super.2019.so" "$extracted/lib/arm64-v8a/" || return 1 ;;
    3) mkdir -p "$extracted/lib/arm64-v8a"
       cp "${LIBS_DIR}/google/libpairipcore.so" "$extracted/lib/arm64-v8a/" || return 1 ;;
    4) mkdir -p "$extracted/lib/arm64-v8a"
       cp "${LIBS_DIR}/arm/libarm_protect.so" "$extracted/lib/arm64-v8a/" || return 1 ;;
    5) mkdir -p "$extracted/assets"
       cp "${LIBS_DIR}/ijiami/ijiami.ajm" "$extracted/assets/" || return 1
       cp "${LIBS_DIR}/ijiami/ijiami_x86.ajm" "$extracted/assets/" || return 1 ;;
    *) return 1 ;;
  esac
  (cd "$extracted" && zip -qr "$out_apk" .) || return 1
  [ -f "$out_apk" ] || return 1
  LIB_RESULT="$out_apk"
  return 0
}

