history_screen(){
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}HISTORY${RESET}"
  box_mid
  if [ ! -f "$HISTORY_FILE" ] || [ ! -s "$HISTORY_FILE" ]; then
    box_line "${DIM}No history yet${RESET}"
  else
    local i=0 date name ptype status mark
    while IFS='|' read -r date name ptype status; do
      i=$((i + 1))
      [ "$i" -gt 8 ] && break
      mark="${GREEN}✓${RESET}"
      [ "$status" = "Failed" ] && mark="${RED}✗${RESET}"
      box_line "$i  ${WHITE}${name}${RESET}  ${mark}  ${CYAN}${ptype}${RESET}"
      box_line "   ${DIM}${date}${RESET}"
    done < <(tail -n 8 "$HISTORY_FILE" | tac 2>/dev/null || tail -n 8 "$HISTORY_FILE")
  fi
  box_bot
  echo
  printf " %s[0]%s Back\n" "$CYAN" "$RESET"
  read_input " ${BOLD}Select:${RESET} " >/dev/null
}

update_screen(){
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}UPDATES${RESET}"
  box_mid
  box_line "Tool    ${GREEN}${TOOL_VERSION}${RESET}"
  box_line "Engine  ${DPT_ENGINE_VERSION:-unknown}"
  box_bot
  echo
  printf "  %s[i]%s Checking...\n" "$CYAN" "$RESET"
  local latest
  latest=$(curl -fsS --connect-timeout 8 --max-time 12 \
    -H "Accept: application/vnd.github+json" "$ENGINE_API" 2>/dev/null \
    | grep -oE '"tag_name"[[:space:]]*:[[:space:]]*"[^"]+"' | head -1 \
    | sed -E 's/.*"tag_name"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')
  echo
  if [ -z "$latest" ]; then
    printf "  %sCould not check (network)%s\n" "$YELLOW" "$RESET"
  elif [ "$latest" = "${DPT_ENGINE_VERSION:-}" ]; then
    printf "  %sEngine up to date (%s)%s\n" "$GREEN" "$latest" "$RESET"
  else
    printf "  Latest engine: %s%s%s\n" "$CYAN" "$latest" "$RESET"
    printf "  %sRe-run install.sh to update%s\n" "$DIM" "$RESET"
  fi
  pause
}

