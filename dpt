  local prompt="${1:- > }"
  local value=""
  printf "%s" "$prompt"
  if read -r value </dev/tty 2>/dev/null; then
    printf '%s' "$value"
    return 0
  fi
  if read -r value; then
    printf '%s' "$value"
    return 0
  fi
  printf ''
  return 1
}

