# ANSI-safe padding so borders never break
box_line(){
  local raw="$1"
  local vis len pad sp i=0
  vis=$(printf '%s' "$raw" | sed -E 's/\x1b\[[0-9;]*m//g')
  len=${#vis}
  if [ "$len" -gt "$BW" ]; then
    # truncate visible only (no ANSI in overflow paths we control)
    vis="${vis:0:$((BW-1))}…"
    raw="$vis"
    len=${#vis}
  fi
  pad=$((BW - len))
  sp=""
  while [ "$i" -lt "$pad" ]; do sp="$sp "; i=$((i+1)); done
  printf "%s║%s %s%s %s║%s\n" "$CYAN" "$RESET" "$raw" "$sp" "$CYAN" "$RESET"
}

clear_screen(){ clear 2>/dev/null || true; }

pause(){
