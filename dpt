protect_flow(){
  load_credits
  if ! can_afford "normal" && ! can_afford "signature"; then
    credits_over_screen
    return
  fi

  clear_screen
  box_top
  box_line "${BOLD}${CYAN}PROTECT APK / AAB${RESET}"
  box_line "${DIM}Enter file path below${RESET}"
  box_bot
  echo
  local apk_path
  apk_path=$(read_input " ${GREEN}>${RESET} ")
  apk_path="${apk_path#\"}"; apk_path="${apk_path%\"}"
  apk_path="${apk_path#\'}"; apk_path="${apk_path%\'}"
  # expand ~ 
  case "$apk_path" in
    "~/"*) apk_path="${HOME}/${apk_path#~/}" ;;
  esac

  if [ -z "$apk_path" ]; then
    clear_screen; box_top; box_line "${RED}No path entered${RESET}"; box_bot; pause; return
  fi
  if [ ! -f "$apk_path" ]; then
    clear_screen; box_top; box_line "${RED}File not found${RESET}"; box_line "$apk_path"; box_bot; pause; return
  fi
  case "${apk_path,,}" in
    *.apk|*.aab) ;;
    *)
      clear_screen; box_top; box_line "${RED}Only APK or AAB allowed${RESET}"; box_bot; pause; return
      ;;
  esac

  clear_screen
  box_top
  box_line "${BOLD}${CYAN}SELECT PROTECTION${RESET}"
  box_mid
  box_line "${GREEN}[1]${RESET} Normal Protection"
  box_line "    ${DIM}Uses 1 credit${RESET}"
  box_line ""
  box_line "${MAGENTA}[2]${RESET} Signature Verification"
  box_line "    ${DIM}Uses 3 Free or 1 VIP credit${RESET}"
  box_bot
  echo
  local ptype_choice mode extra_flags ptype_label
  ptype_choice=$(read_input " ${BOLD}Select:${RESET} ")
  ptype_choice=$(printf '%s' "$ptype_choice" | tr -d '[:space:]')
  mode="normal"
  extra_flags=()
  ptype_label="Normal"
  case "$ptype_choice" in
    2) mode="signature"; extra_flags+=("-vs"); ptype_label="Signature" ;;
    1|"") mode="normal"; ptype_label="Normal" ;;
    *) mode="normal"; ptype_label="Normal" ;;
  esac

  if ! can_afford "$mode"; then
    clear_screen
    box_top
    box_line "${YELLOW}Not enough credits${RESET}"
    if [ "$mode" = "signature" ]; then
      box_line "Need 3 Free or 1 VIP credit"
    else
      box_line "Need at least 1 credit"
    fi
    box_bot
    pause
    return
  fi

  local out_root="${STORAGE_ROOT:-/storage/emulated/0}/${OUTPUT_FOLDER}"
  if ! mkdir -p "$out_root" 2>/dev/null; then
    clear_screen
    box_top
    box_line "${RED}Cannot create @SRCTMH folder${RESET}"
    box_line "Check storage permission"
    box_bot
    pause
    return
  fi

  local apk_name apk_base apk_ext work_dir log_out
  apk_name=$(basename "$apk_path")
  apk_ext="${apk_name##*.}"
  apk_base="${apk_name%.*}"
  work_dir="${TMP_BASE}/protect_$$"
  rm -rf "$work_dir"
  mkdir -p "$work_dir"

  # Animated steps before engine
  show_protect_progress 0; sleep 0.45
  show_protect_progress 1; sleep 0.45
  show_protect_progress 2; sleep 0.35

  log_out="${work_dir}/run.log"
  # Run engine in background so we can animate
  (
    cd "$DPT_RUNTIME" || exit 90
    if [ "${#extra_flags[@]}" -gt 0 ]; then
      java -jar "$DPT_JAR" -f "$apk_path" -o "$work_dir" "${extra_flags[@]}"
    else
      java -jar "$DPT_JAR" -f "$apk_path" -o "$work_dir"
    fi
  ) >"$log_out" 2>&1 &
  local eng_pid=$!

  # While engine runs, show stage 3
  show_protect_progress 3
  local waited=0
  while kill -0 "$eng_pid" 2>/dev/null; do
    sleep 0.5
    waited=$((waited + 1))
    # after some time move to signing visual
    if [ "$waited" -eq 4 ]; then show_protect_progress 4; fi
  done
  wait "$eng_pid"
  local status=$?

  if [ "$status" -ne 0 ]; then
    local reason
    reason=$(tail -n 5 "$log_out" 2>/dev/null | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g' | cut -c1-34)
    [ -z "$reason" ] && reason="Unknown error"
    clear_screen
    box_top
    box_line "${RED}${BOLD}✗ PROTECTION FAILED${RESET}"
    box_mid
    box_line "Reason: $reason"
    box_bot
    log_history "$apk_name" "$ptype_label" "Failed"
    rm -rf "$work_dir"
    pause
    return
  fi

  show_protect_progress 5
  sleep 0.35

  local produced final_path
  produced=$(find "$work_dir" -type f \( -name "*_signed.apk" -o -name "*.apk" -o -name "*.aab" \) ! -name "*_unsign*" -print 2>/dev/null | head -n1)
  if [ -z "$produced" ]; then
    clear_screen
    box_top
    box_line "${RED}No output file found${RESET}"
    box_bot
    log_history "$apk_name" "$ptype_label" "Failed"
    rm -rf "$work_dir"
    pause
    return
  fi

  final_path=$(unique_output_name "$out_root" "$apk_base" "$apk_ext")
  if ! mv "$produced" "$final_path"; then
    clear_screen
    box_top
    box_line "${RED}Could not save output${RESET}"
    box_bot
    rm -rf "$work_dir"
    pause
    return
  fi
  rm -rf "$work_dir"
  deduct_for "$mode"
  log_history "$apk_name" "$ptype_label" "Success"
  load_credits

  clear_screen
