#!/data/data/com.termux/files/usr/bin/bash
# SRC TMH DPT — Runtime (Protected)
set -euo pipefail
B64=''
TMP="$(mktemp -d 2>/dev/null || true)"
if [ -z "${TMP:-}" ]; then
  TMP="/data/data/com.termux/files/usr/tmp/dptpro$$"
  mkdir -p "$TMP"
fi
F="$TMP/run"
printf '%s' "$B64" | base64 -d | python3 -c 'import sys,zlib;sys.stdout.buffer.write(zlib.decompress(sys.stdin.buffer.read()))' > "$F"
chmod 700 "$F"
bash "$F" "$@"
C=$?
rm -rf "$TMP"
exit $C
