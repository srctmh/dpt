# -------------------- device id --------------------
get_device_id(){
  local android_id termux_hash raw hex
  android_id=""
  android_id=$(getprop ro.serialno 2>/dev/null || true)
  if [ -z "$android_id" ] || [ "$android_id" = "unknown" ]; then
    android_id=$(getprop ro.boot.serialno 2>/dev/null || true)
  fi
  if [ -z "$android_id" ]; then
    android_id=$(cat /data/data/com.termux/files/usr/etc/uuid 2>/dev/null || true)
  fi
  if [ -z "$android_id" ]; then
    android_id="UNKNOWN"
  fi
  termux_hash=$(printf '%s' "${PREFIX:-$HOME}" | cksum 2>/dev/null | awk '{print $1}')
  raw="${android_id}-${termux_hash}-SRCTMH"
  hex=$(printf '%s' "$raw" | md5sum 2>/dev/null | awk '{print $1}' | head -c 12 | tr 'a-f' 'A-F')
  if [ -z "$hex" ]; then
    hex=$(printf '%s' "$raw" | cksum | awk '{print $1}' | head -c 12)
  fi
  printf 'SRCTMH-%s\n' "$hex"
}

# -------------------- credits --------------------
init_credits(){
  mkdir -p "$BASE"
  if [ ! -f "$CREDITS_FILE" ]; then
    cat > "$CREDITS_FILE" <<EOF
device_id=$(get_device_id)
free_credits=3
vip_credits=0
last_reset=$(date +%s)
EOF
  fi
}

save_credits(){
  cat > "$CREDITS_FILE" <<EOF
device_id=${DEVICE_ID}
free_credits=${FREE_CREDITS}
vip_credits=${VIP_CREDITS}
last_reset=${LAST_RESET}
EOF
}

load_credits(){
  init_credits
  # shellcheck disable=SC1090
  . "$CREDITS_FILE"
  DEVICE_ID="${device_id:-$(get_device_id)}"
  FREE_CREDITS="${free_credits:-3}"
  VIP_CREDITS="${vip_credits:-0}"
  LAST_RESET="${last_reset:-$(date +%s)}"

  # sanitize numbers
  case "$FREE_CREDITS" in (*[!0-9]*|"") FREE_CREDITS=0 ;; esac
  case "$VIP_CREDITS" in (*[!0-9]*|"") VIP_CREDITS=0 ;; esac
  case "$LAST_RESET" in (*[!0-9]*|"") LAST_RESET=$(date +%s) ;; esac

  local now diff
  now=$(date +%s)
  diff=$((now - LAST_RESET))
  if [ "$diff" -ge 604800 ]; then
    FREE_CREDITS=3
    LAST_RESET=$now
    save_credits
  fi
}

total_credits(){ echo $((FREE_CREDITS + VIP_CREDITS)); }

days_until_reset(){
  local now diff left
  now=$(date +%s)
  diff=$((now - LAST_RESET))
  left=$((604800 - diff))
  if [ "$left" -le 0 ]; then echo 0; return; fi
  echo $((left / 86400 + 1))
}

can_afford(){
  local mode="$1"
  if [ "$mode" = "signature" ]; then
    [ "$VIP_CREDITS" -ge 1 ] && return 0
    [ "$FREE_CREDITS" -ge 3 ] && return 0
    return 1
  fi
  [ "$FREE_CREDITS" -ge 1 ] && return 0
  [ "$VIP_CREDITS" -ge 1 ] && return 0
  return 1
}

deduct_for(){
  local mode="$1"
  if [ "$mode" = "signature" ]; then
    if [ "$VIP_CREDITS" -ge 1 ]; then
      VIP_CREDITS=$((VIP_CREDITS - 1)); save_credits; return 0
    fi
    if [ "$FREE_CREDITS" -ge 3 ]; then
      FREE_CREDITS=$((FREE_CREDITS - 3)); save_credits; return 0
    fi
    return 1
  fi
  if [ "$FREE_CREDITS" -ge 1 ]; then
    FREE_CREDITS=$((FREE_CREDITS - 1)); save_credits; return 0
  fi
  if [ "$VIP_CREDITS" -ge 1 ]; then
    VIP_CREDITS=$((VIP_CREDITS - 1)); save_credits; return 0
  fi
  return 1
}

# -------------------- key system --------------------
hex_to_charset(){
  local hex="$1" len="$2" out="" i=0 byte
  while [ ${#out} -lt "$len" ] && [ "$i" -lt ${#hex} ]; do
    byte=$((16#${hex:$i:2}))
    out="${out}${KEY_CHARS:$((byte % 32)):1}"
    i=$((i + 2))
  done
  printf '%s\n' "$out"
}

generate_key_for(){
  local did="$1" credits="$2" payload hash body checksum
  payload="${did}|${credits}|v1|${SECRET_SALT}"
  hash=$(printf '%s' "$payload" | sha256sum 2>/dev/null | awk '{print $1}')
  if [ -z "$hash" ]; then
    hash=$(printf '%s' "$payload" | md5sum 2>/dev/null | awk '{print $1}')
    hash="${hash}${hash}"
  fi
  body=$(hex_to_charset "$hash" 16)
  checksum=$(hex_to_charset "${hash: -16}" 4)
  printf 'SRCTMH-%s-%s-%s-%s-%s\n' "${body:0:4}" "${body:4:4}" "${body:8:4}" "${body:12:4}" "$checksum"
}

decode_credits_from_key(){
  local key="$1" did="$DEVICE_ID" c gen
  for c in 1 5 10 15 20 25 30 40 50 60 75 80 100 120 150 200 250 300 400 500 750 1000 1500 2000 2500 3000 5000 10000; do
    gen=$(generate_key_for "$did" "$c")
    if [ "$gen" = "$key" ]; then printf '%s\n' "$c"; return 0; fi
  done
  c=1
  while [ "$c" -le 2000 ]; do
    gen=$(generate_key_for "$did" "$c")
    if [ "$gen" = "$key" ]; then printf '%s\n' "$c"; return 0; fi
    c=$((c + 1))
  done
  printf '\n'
  return 1
}

verify_and_activate_key(){
  local key="$1" credits
  key=$(printf '%s' "$key" | tr -d '[:space:]' | tr 'a-z' 'A-Z')
  if ! printf '%s' "$key" | grep -qE '^SRCTMH-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}$'; then
    echo "INVALID_FORMAT"; return 1
  fi
  mkdir -p "$BASE"
  if [ -f "$ACTIVATED_FILE" ] && grep -qxF "$key" "$ACTIVATED_FILE" 2>/dev/null; then
    echo "ALREADY_USED"; return 1
  fi
  credits=$(decode_credits_from_key "$key")
  if [ -z "$credits" ]; then echo "INVALID_KEY"; return 1; fi
  case "$credits" in (*[!0-9]*) echo "INVALID_KEY"; return 1 ;; esac
  if [ "$credits" -lt 1 ]; then echo "INVALID_KEY"; return 1; fi
  VIP_CREDITS=$((VIP_CREDITS + credits))
  save_credits
  echo "$key" >> "$ACTIVATED_FILE"
  echo "$credits"
  return 0
}

# -------------------- kill switch --------------------
check_kill_switch(){
  local json status msg
  json=$(curl -fsS --connect-timeout 5 --max-time 8 "$KILL_SWITCH_URL" 2>/dev/null || true)
  [ -z "$json" ] && return 0
  status=$(printf '%s' "$json" | grep -oE '"status"[[:space:]]*:[[:space:]]*"[^"]+"' | head -1 | sed -E 's/.*"status"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')
  if [ "$status" = "disabled" ]; then
    msg=$(printf '%s' "$json" | grep -oE '"message"[[:space:]]*:[[:space:]]*"[^"]+"' | head -1 | sed -E 's/.*"message"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')
    clear_screen
    box_top
    box_line "${RED}${BOLD}SERVICE UNAVAILABLE${RESET}"
    box_mid
    box_line "${msg:-Temporarily disabled}"
    box_line "Contact ${MAGENTA}@srcmax${RESET}"
    box_bot
    echo
    exit 1
  fi
}

