        fi
        result=$(verify_and_activate_key "$key")
        ok=$?
        clear_screen
        if [ "$ok" -eq 0 ]; then
          box_top
          box_line "${GREEN}${BOLD}✓ VIP KEY ACTIVATED${RESET}"
          box_mid
          box_line "${GREEN}+${result}${RESET} VIP credits added"
          box_line "Total VIP credits: ${MAGENTA}${VIP_CREDITS}${RESET}"
          box_bot
          pause
          return
        else
          box_top
          box_line "${RED}${BOLD}✗ INVALID KEY${RESET}"
          box_mid
          case "$result" in
            ALREADY_USED) box_line "Key already used" ;;
            INVALID_FORMAT) box_line "Wrong key format" ;;
